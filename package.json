{
  "name": "bactosense-manual",
  "version": "3.2.0",
  "private": true,
  "description": "BactoSense user manual, extracted from UM_0006-01EN",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1",
    "build": "node scripts/build-manual.mjs",
    "serve": "docusaurus serve --host 127.0.0.1",
    "manual:check": "node scripts/check-manual.mjs",
    "browser:install": "playwright install chromium",
    "manual:pdf": "node scripts/compile-pdf.mjs",
    "translations:check": "node scripts/check-translations.mjs",
    "screenshots:prepare": "node scripts/gui-capture/prepare-figures.mjs",
    "screenshots:render": "node scripts/gui-capture/render-figures.mjs",
    "screenshots:apply": "node scripts/gui-capture/apply-figures.mjs",
    "screenshots:check": "node scripts/gui-capture/check-figures.mjs",
    "prebuild": "npm run translations:check && npm run screenshots:check",
    "manual:format": "node scripts/simplify-markdown.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "cheerio": "1.0.0-rc.12"
  }
}
